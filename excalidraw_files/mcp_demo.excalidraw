    {
      "id": "VKkYpd_tj16De-CKDiv9-",
      "type": "text",
      "x": 119.4444020589192,
      "y": 244.0567253960503,
      "width": 861.8395385742188,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
