      "isDeleted": false,
      "boundElements": [],
      "updated": 1783147170911,
      "link": null,
      "locked": false,
      "text": " MCP stands for Model Context Protocol. It acts like a universal \"USB-C port\" for AI. \nInstead of building custom APIs to link an AI model to GitHub, Google Drive, \nor a local database, developers use MCP to create a standardized link",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " MCP stands for Model Context Protocol. It acts like a universal \"USB-C port\" for AI. \nInstead of building custom APIs to link an AI model to GitHub, Google Drive, \nor a local database, developers use MCP to create a standardized link",
      "autoResize": true,
      "lineHeight": 1.25
    },
